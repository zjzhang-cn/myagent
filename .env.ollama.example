# Ollama 本地模型环境配置
#
# 使用方法：
#   cp .env.ollama.example .env
#   或
#   uv run python -m ai_agent.main --env-file .env.ollama.example
#
# 前置条件：
#   1. 安装 Ollama: https://ollama.com
#   2. 拉取模型: ollama pull deepseek-r1:7b
#   3. 确保 Ollama 服务运行中

# Ollama 提供兼容 API，地址为 http://127.0.0.1:11434/v1
LLM_BASE_URL=http://127.0.0.1:11434/v1

# Ollama 不需要 API Key，但不能为空，设为一个占位值即可
LLM_API_KEY=ollama

# 模型名称（需已通过 ollama pull 拉取）
# 常用模型: deepseek-r1:7b, qwen2.5:7b, llama3.2:3b, mistral:7b
AGENT_MODEL=minimax-m2.5:cloud

# 生成温度（可选，0.0-2.0，默认 0.7）
# AGENT_TEMPERATURE=0.7
