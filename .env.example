# ============================================================
# AI Agent 环境配置文件
# ============================================================
#
# 使用方式：
#   cp .env.example .env  → 编辑 .env → uv run python -m ai_agent.main
#   或通过 --env-file 指定：
#   uv run python -m ai_agent.main --env-file .env.example

# ============================================================
# 通用 LLM 配置
# ============================================================

# API 密钥（必填，OpenAI / Anthropic 通用）
LLM_API_KEY=sk-your-api-key-here

# API 基础地址（可选）
# 不填则根据模型名自动推断，Anthropic 默认 https://api.anthropic.com
# OpenAI:      https://api.openai.com/v1
# DeepSeek:    https://api.deepseek.com/v1
# Moonshot:    https://api.moonshot.cn/v1
# SiliconFlow: https://api.siliconflow.cn/v1
# Zhipu:       https://open.bigmodel.cn/api/paas/v4
# Groq:        https://api.groq.com/openai/v1
# Ollama:      http://127.0.0.1:11434/v1
# 代理/网关:   https://your-proxy.com
# LLM_BASE_URL=

# LLM 后端类型（可选，openai / anthropic，默认 openai）
LLM_TYPE=openai

# 模型名称（必填，以 claude 开头自动路由到 Anthropic 后端）
# OpenAI:      gpt-4o, gpt-4.1, o4-mini
# Anthropic:   claude-sonnet-4-20250514, claude-opus-4-20250514, claude-haiku-4-5-20251001
# DeepSeek:    deepseek-v4-flash, deepseek-r1
# Moonshot:    moonshot-v1-8k
# SiliconFlow: deepseek-ai/DeepSeek-V4-Flash
# Ollama:      minimax-m2.5:cloud, qwen2.5:7b, llama3.2:3b
AGENT_MODEL=deepseek-v4-flash

# 生成温度（可选，0.0-2.0，默认 0.7）
# 注意：Claude 启用扩展思考时会被忽略
# AGENT_TEMPERATURE=0.7

# 单次输出最大 token 数（可选，默认 4096）
# Claude 上下文窗口 200K，可适当调大
# AGENT_MAX_TOKENS=4096

# ============================================================
# 循环控制
# ============================================================

# ReAct 循环最大轮次（可选，0=不限制，默认 0）
# AGENT_MAX_ITERATIONS=0

# 工具调用最大轮数（可选，0=不限制，默认 0）
# 限制单次 run() 中 LLM 实际调用工具的迭代次数
# AGENT_MAX_TOOL_ROUNDS=0

# ============================================================
# 上下文与记忆
# ============================================================

# 最大上下文 token 数（可选，超出自动裁剪，默认 65536 / 64K）
# Claude 支持 200K，可调大但注意成本
# AGENT_MAX_CONTEXT_TOKENS=65536

# 单条工具结果最大字符数（可选，超出截断，默认 32768 / 32K）
# AGENT_MAX_TOOL_RESULT_CHARS=32768

# ============================================================
# 会话与状态
# ============================================================

# 会话状态存储目录（可选，默认 ~/.ai_agent/sessions）
# AGENT_STATE_DIR=~/.ai_agent/sessions

# 长期记忆数据库路径（可选，默认 ~/.ai_agent/long_term_memory.db）
# AGENT_MEMORY_PATH=~/.ai_agent/long_term_memory.db

# ============================================================
# 工具配置
# ============================================================

# 自定义工具目录，启动时自动加载其中 @tool 装饰的 .py 文件
# （可选，默认 ~/.ai_agent/tools）
# AGENT_TOOLS_DIR=~/.ai_agent/tools

# ============================================================
# 技能配置
# ============================================================

# 技能定义目录（可选，多个目录用 : 分隔）
# 不设置时默认加载 ~/.ai_agent/skills 和 ./.ai_agent/skills
# 设置后仅加载指定目录
# AGENT_SKILLS_DIR=~/.ai_agent/skills

# ============================================================
# 使用示例
# ============================================================
#
# # DeepSeek
# LLM_API_KEY=sk-your-deepseek-key
# AGENT_MODEL=deepseek-v4-flash
#
# # Anthropic Claude
# LLM_API_KEY=sk-ant-your-anthropic-key
# AGENT_MODEL=claude-sonnet-4-20250514
#
# # Ollama 本地模型
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# AGENT_MODEL=qwen2.5:7b
#
# # 通过代理访问
# LLM_API_KEY=sk-your-key
# LLM_BASE_URL=https://your-proxy.com/v1
# AGENT_MODEL=gpt-4o
