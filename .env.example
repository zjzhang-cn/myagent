# === LLM 配置 ===

# API 密钥（必填）
OPENAI_API_KEY=sk-your-api-key-here

# API 基础地址（可选，不填则根据模型名自动推断）
# DeepSeek:   https://api.deepseek.com/v1
# Moonshot:   https://api.moonshot.cn/v1
# SiliconFlow: https://api.siliconflow.cn/v1
# OpenAI:     https://api.openai.com/v1
OPENAI_BASE_URL=

# 模型名称（可选，默认 deepseek-v4-flash）
AGENT_MODEL=deepseek-v4-flash

# 生成温度（可选，0.0-2.0，默认 0.7）
# AGENT_TEMPERATURE=0.7

# === Agent 行为 ===

# ReAct 循环最大轮次（可选，默认 15）
# AGENT_MAX_ITERATIONS=15

# 是否启用任务规划（可选，默认 true）
# AGENT_ENABLE_PLANNING=true

# === 路径配置 ===

# 长期记忆数据库路径（可选）
# AGENT_MEMORY_PATH=~/.ai_agent/long_term_memory.db

# 文件操作允许的目录（可选，默认当前目录，多个用逗号分隔）
# AGENT_WORKSPACE_DIRS=.,~/projects
